{
  "$comment": "Arche UI token contract v1. Encodes the whole token surface from the Library Creation Spec §4.2. Token names are CSS-variable form. Colors are OKLCH. Every token requires a value in BOTH the light and the dark set of an identity. Amendment 2026-11 (Brand Token brief, same append-only pattern as --border-width): --brand and --brand-foreground join the contract; existing payloads predate them and gain them on regeneration (brandHue defaults to primaryHue).",
  "contractVersion": 1,
  "colorSpace": "oklch",
  "modes": ["light", "dark"],
  "tokens": [
    { "name": "--background", "$type": "color", "group": "surfaces" },
    { "name": "--card", "$type": "color", "group": "surfaces" },
    { "name": "--popover", "$type": "color", "group": "surfaces" },
    { "name": "--foreground", "$type": "color", "group": "on-surface", "contrastPair": { "fg": "--foreground", "bg": "--background" } },
    { "name": "--card-foreground", "$type": "color", "group": "on-surface", "contrastPair": { "fg": "--card-foreground", "bg": "--card" } },
    { "name": "--popover-foreground", "$type": "color", "group": "on-surface", "contrastPair": { "fg": "--popover-foreground", "bg": "--popover" } },
    { "name": "--primary", "$type": "color", "group": "actions", "contrastPair": { "fg": "--primary-foreground", "bg": "--primary" } },
    { "name": "--primary-foreground", "$type": "color", "group": "actions" },
    { "name": "--secondary", "$type": "color", "group": "actions", "contrastPair": { "fg": "--secondary-foreground", "bg": "--secondary" } },
    { "name": "--secondary-foreground", "$type": "color", "group": "actions" },
    { "name": "--accent", "$type": "color", "group": "actions", "contrastPair": { "fg": "--accent-foreground", "bg": "--accent" } },
    { "name": "--accent-foreground", "$type": "color", "group": "actions" },
    { "name": "--destructive", "$type": "color", "group": "actions", "contrastPair": { "fg": "--destructive-foreground", "bg": "--destructive" } },
    { "name": "--destructive-foreground", "$type": "color", "group": "actions" },
    { "name": "--brand", "$type": "color", "group": "brand", "contrastPair": { "fg": "--brand-foreground", "bg": "--brand" } },
    { "name": "--brand-foreground", "$type": "color", "group": "brand" },
    { "name": "--muted", "$type": "color", "group": "quiet-ui", "contrastPair": { "fg": "--muted-foreground", "bg": "--muted" } },
    { "name": "--muted-foreground", "$type": "color", "group": "quiet-ui" },
    { "name": "--border", "$type": "color", "group": "structure" },
    { "name": "--input", "$type": "color", "group": "structure" },
    { "name": "--ring", "$type": "color", "group": "structure" },
    { "name": "--chart-1", "$type": "color", "group": "data" },
    { "name": "--chart-2", "$type": "color", "group": "data" },
    { "name": "--chart-3", "$type": "color", "group": "data" },
    { "name": "--chart-4", "$type": "color", "group": "data" },
    { "name": "--chart-5", "$type": "color", "group": "data" },
    { "name": "--radius", "$type": "dimension", "group": "shape", "$note": "sm/md/lg/xl are derived by calc() at emission; only the base is a token." },
    { "name": "--border-width", "$type": "dimension", "group": "shape", "values": ["0px", "1px", "2px", "3px"], "$note": "Mode-independent: same value light/dark. Component templates use border-(length:--border-width); never hardcode a border width. Per-profile bounds for generated payloads live in design rule border-width-profile-bounds." },
    { "name": "--font-sans", "$type": "fontFamily", "group": "type" },
    { "name": "--font-display", "$type": "fontFamily", "group": "type" },
    { "name": "--font-mono", "$type": "fontFamily", "group": "type" },
    { "name": "--shadow-sm", "$type": "shadow", "group": "depth" },
    { "name": "--shadow-md", "$type": "shadow", "group": "depth" },
    { "name": "--shadow-lg", "$type": "shadow", "group": "depth" },
    { "name": "--shadow-xl", "$type": "shadow", "group": "depth" },
    { "name": "--motion-fast", "$type": "motion", "group": "motion", "subValues": [{ "$type": "duration", "key": "duration" }, { "$type": "cubicBezier", "key": "easing" }], "$note": "Duration + easing pair." },
    { "name": "--motion-normal", "$type": "motion", "group": "motion", "subValues": [{ "$type": "duration", "key": "duration" }, { "$type": "cubicBezier", "key": "easing" }], "$note": "Duration + easing pair." }
  ],
  "contrastPairs": [
    { "fg": "--foreground", "bg": "--background", "minRatio": 4.5 },
    { "fg": "--card-foreground", "bg": "--card", "minRatio": 4.5 },
    { "fg": "--popover-foreground", "bg": "--popover", "minRatio": 4.5 },
    { "fg": "--primary-foreground", "bg": "--primary", "minRatio": 4.5 },
    { "fg": "--secondary-foreground", "bg": "--secondary", "minRatio": 4.5 },
    { "fg": "--accent-foreground", "bg": "--accent", "minRatio": 4.5 },
    { "fg": "--destructive-foreground", "bg": "--destructive", "minRatio": 4.5 },
    { "fg": "--brand-foreground", "bg": "--brand", "minRatio": 4.5 },
    { "fg": "--muted-foreground", "bg": "--muted", "minRatio": 4.5 }
  ]
}
