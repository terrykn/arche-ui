{
  "name": "ripple",
  "title": "Ripple",
  "description": "Concentric rings pulsing outward.",
  "category": "background",
  "manifestVersion": 1,
  "primitive": {
    "package": "react",
    "parts": [
      "Root"
    ],
    "propsInherited": true
  },
  "slots": [
    {
      "name": "root",
      "part": "Root",
      "required": true
    }
  ],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [
    "--brand",
    "--border-width"
  ],
  "dependencies": [],
  "registryDependencies": [
    "utils"
  ],
  "files": [
    {
      "name": "ripple",
      "source": "src/templates/ripple.tsx",
      "target": "components/ui/ripple.tsx",
      "type": "registry:ui"
    }
  ],
  "standards": {
    "purpose": "Concentric rings pulsing outward.",
    "useWhen": [
      "Calm listening states."
    ],
    "doNotUseWhen": [
      "Busy screens."
    ],
    "rules": [
      {
        "id": "ripple-accessible-name",
        "severity": "error",
        "check": "Every interactive control has an accessible name."
      }
    ]
  }
}
