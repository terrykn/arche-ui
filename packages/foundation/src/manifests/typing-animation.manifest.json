{
  "name": "typing-animation",
  "title": "Typing Animation",
  "description": "Characters appearing as typed.",
  "category": "typography",
  "manifestVersion": 1,
  "primitive": {
    "package": "react",
    "parts": [
      "Root"
    ],
    "propsInherited": true
  },
  "slots": [
    {
      "name": "root",
      "part": "Root",
      "required": true
    }
  ],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [],
  "dependencies": [
    "motion"
  ],
  "registryDependencies": [
    "utils"
  ],
  "files": [
    {
      "name": "typing-animation",
      "source": "src/templates/typing-animation.tsx",
      "target": "components/ui/typing-animation.tsx",
      "type": "registry:ui"
    }
  ],
  "standards": {
    "purpose": "Characters appearing as typed.",
    "useWhen": [
      "Terminal effects."
    ],
    "doNotUseWhen": [
      "Instant text."
    ],
    "rules": [
      {
        "id": "typing-animation-accessible-name",
        "severity": "error",
        "check": "Every interactive control has an accessible name."
      }
    ]
  }
}
