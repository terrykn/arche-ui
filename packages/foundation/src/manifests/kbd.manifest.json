    },
    {
      "name": "group",
      "part": "Root",
      "required": false
    }
  ],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [
    "--background",
    "--muted",
    "--muted-foreground",
    "--radius",
    "--font-sans"
  ],
  "dependencies": [],
