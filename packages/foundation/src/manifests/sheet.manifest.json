{
  "name": "sheet",
  "title": "Sheet",
  "description": "A side panel dialog.",
  "category": "overlay",
  "manifestVersion": 1,
  "primitive": {
    "package": "@radix-ui/react-dialog",
    "parts": [
      "Root",
      "Trigger",
      "Close",
      "Portal",
      "Overlay",
      "Content",
      "Title",
      "Description"
    ],
    "propsInherited": true
  },
  "slots": [
    {
      "name": "root",
      "part": "Root",
      "required": true
    },
    {
      "name": "trigger",
      "part": "Trigger",
      "required": false
    },
    {
      "name": "close",
      "part": "Close",
      "required": false
    },
    {
      "name": "portal",
      "part": "Portal",
      "required": false
    },
    {
      "name": "overlay",
      "part": "Overlay",
      "required": false
    },
    {
      "name": "content",
      "part": "Content",
      "required": false
    },
    {
      "name": "header",
      "part": "Root",
      "required": false
    },
    {
      "name": "footer",
      "part": "Root",
      "required": false
    },
    {
      "name": "title",
      "part": "Title",
      "required": false
    },
    {
      "name": "description",
      "part": "Description",
      "required": false
    }
  ],
  "axes": {},
  "styleSurface": {
    "root": {
      "width": {
        "type": "enum",
        "values": [
          "16rem",
          "18rem",
          "20rem",
          "24rem",
          "28rem",
          "32rem",
          "36rem",
          "42rem",
          "56rem"
        ],
        "default": "24rem",
        "cssVar": "--sheet-width"
      },
      "overlayOpacity": {
        "type": "enum",
        "values": [
          "20%",
          "30%",
          "40%",
          "50%",
          "60%",
          "70%"
        ],
        "default": "40%",
        "cssVar": "--sheet-overlay-opacity"
      }
    }
  },
  "tokensUsed": [
    "--background",
    "--foreground",
    "--secondary",
    "--muted-foreground",
    "--ring",
    "--radius",
    "--border-width",
    "--shadow-lg",
    "--motion-normal"
  ],
  "dependencies": [
    "@radix-ui/react-dialog",
    "lucide-react"
  ],
  "registryDependencies": [
    "utils"
  ],
  "files": [
    {
      "name": "sheet",
      "source": "src/templates/sheet.tsx",
      "target": "components/ui/sheet.tsx",
      "type": "registry:ui"
    }
  ],
  "standards": {
    "purpose": "A side panel dialog.",
    "useWhen": [
      "Editing details beside the page."
    ],
    "doNotUseWhen": [
      "A short confirmation is enough."
    ],
    "rules": [
      {
        "id": "sheet-accessible-name",
        "severity": "error",
        "check": "Every interactive control has an accessible name."
      }
    ]
  }
}
