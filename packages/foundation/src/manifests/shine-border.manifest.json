{
  "name": "shine-border",
  "title": "Shine Border",
  "description": "An animated shine border.",
  "category": "cards",
  "manifestVersion": 1,
  "primitive": {
    "package": "react",
    "parts": [
      "Root"
    ],
    "propsInherited": true
  },
  "slots": [
    {
      "name": "root",
      "part": "Root",
      "required": true
    }
  ],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [
    "--border-width"
  ],
  "dependencies": [],
  "registryDependencies": [
    "utils"
  ],
  "files": [
    {
      "name": "shine-border",
      "source": "src/templates/shine-border.tsx",
      "target": "components/ui/shine-border.tsx",
      "type": "registry:ui"
    }
  ],
  "standards": {
    "purpose": "An animated shine border.",
    "useWhen": [
      "Highlighted panels."
    ],
    "doNotUseWhen": [
      "Default borders."
    ],
    "rules": [
      {
        "id": "shine-border-accessible-name",
        "severity": "error",
        "check": "Every interactive control has an accessible name."
      }
    ]
  }
}
