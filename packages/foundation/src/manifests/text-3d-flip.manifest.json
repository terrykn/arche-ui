{
  "name": "text-3d-flip",
  "title": "Text 3D Flip",
  "description": "Letters flipping in 3D on hover.",
  "category": "typography",
  "manifestVersion": 1,
  "primitive": {
    "package": "react",
    "parts": [
      "Root"
    ],
    "propsInherited": true
