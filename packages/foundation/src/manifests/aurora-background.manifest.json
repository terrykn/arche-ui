    "utils"
  ],
  "files": [
    {
      "name": "aurora-background",
      "source": "src/templates/aurora-background.tsx",
      "target": "components/ui/aurora-background.tsx",
      "type": "registry:ui"
    }
  ],
  "standards": {
    "purpose": "A drifting aurora gradient backdrop.",
    "useWhen": [
      "Atmospheric heroes."
    ],
    "doNotUseWhen": [
      "Dense dashboards."
    ],
    "rules": [
      {
        "id": "aurora-background-accessible-name",
        "severity": "error",
        "check": "Every interactive control has an accessible name."
      }
    ]
