{
  "name": "aurora-background",
  "title": "Aurora Background",
  "description": "A drifting aurora gradient backdrop.",
  "category": "background",
  "manifestVersion": 1,
  "primitive": {
    "package": "react",
    "parts": [
      "Root"
    ],
    "propsInherited": true
  },
  "slots": [
    {
      "name": "root",
      "part": "Root",
      "required": true
    }
  ],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [],
  "dependencies": [],
