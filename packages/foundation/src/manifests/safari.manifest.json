{
  "name": "safari",
  "title": "Safari",
  "description": "A Safari browser mockup.",
  "category": "media",
  "manifestVersion": 1,
  "primitive": {
    "package": "react",
    "parts": [
      "Root"
    ],
    "propsInherited": true
  },
  "slots": [
    {
      "name": "root",
      "part": "Root",
      "required": true
    }
  ],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [
    "--background",
    "--card",
    "--muted",
    "--muted-foreground"
  ],
  "dependencies": [],
  "registryDependencies": [],
  "files": [
    {
      "name": "safari",
      "source": "src/templates/safari.tsx",
      "target": "components/ui/safari.tsx",
      "type": "registry:ui"
    }
  ],
  "standards": {
    "purpose": "A Safari browser mockup.",
    "useWhen": [
      "Website showcases."
    ],
    "doNotUseWhen": [
      "Native apps."
    ],
    "rules": [
      {
        "id": "safari-accessible-name",
        "severity": "error",
        "check": "Every interactive control has an accessible name."
      }
    ]
  }
}
