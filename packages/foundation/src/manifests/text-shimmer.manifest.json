{
  "name": "text-shimmer",
  "title": "Text Shimmer",
  "description": "A soft light sweep for loading states.",
  "category": "typography",
  "manifestVersion": 1,
  "primitive": {
    "package": "react",
    "parts": [
      "Root"
    ],
    "propsInherited": true
  },
  "slots": [
    {
      "name": "root",
      "part": "Root",
      "required": true
    }
  ],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [],
  "dependencies": [],
  "registryDependencies": [
    "utils"
  ],
  "files": [
    {
      "name": "text-shimmer",
      "source": "src/templates/text-shimmer.tsx",
      "target": "components/ui/text-shimmer.tsx",
      "type": "registry:ui"
    }
  ],
  "standards": {
    "purpose": "A soft light sweep for loading states.",
    "useWhen": [
      "AI waiting states."
    ],
    "doNotUseWhen": [
      "Final content."
    ],
    "rules": [
      {
        "id": "text-shimmer-accessible-name",
        "severity": "error",
        "check": "Every interactive control has an accessible name."
      }
    ]
  }
}
