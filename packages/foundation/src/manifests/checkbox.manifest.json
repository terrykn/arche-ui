  "standards": { "purpose": "Select or clear an independent option.", "useWhen": ["Multiple options can be selected independently."], "doNotUseWhen": ["Only one option is allowed from a group."], "rules": [{ "id": "checkbox-accessible-label", "severity": "error", "check": "Associate every checkbox with an accessible label." }] }
