{
  "name": "checkbox", "title": "Checkbox", "description": "Selects an independent boolean or indeterminate value.", "category": "forms", "manifestVersion": 1,
  "primitive": { "package": "@radix-ui/react-checkbox", "parts": ["Root", "Indicator"], "propsInherited": true },
  "slots": [{ "name": "root", "part": "Root", "required": true }, { "name": "indicator", "part": "Indicator", "required": true }],
  "axes": { "size": { "values": ["sm", "default", "lg"], "default": "default" } },
  "styleSurface": { "root": { "radiusFrom": { "type": "token", "value": "--radius", "scale": ["sm", "md", "lg", "xl"], "default": "sm" } } },
  "tokensUsed": ["--border", "--input", "--ring", "--primary", "--primary-foreground", "--radius"],
  "dependencies": ["@radix-ui/react-checkbox", "class-variance-authority", "lucide-react"], "registryDependencies": ["utils"],
