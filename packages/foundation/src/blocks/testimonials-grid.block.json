{
  "name": "testimonials-grid",
  "title": "Testimonial grid",
  "description": "Masonry wall of social posts and quote cards, led by a wide case-study quote with a headline metric.",
  "category": "marketing",
  "manifestVersion": 1,
  "block": true,
  "slots": [],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [
    "--border-width",
    "--brand",
    "--brand-foreground",
    "--card",
    "--card-foreground",
    "--muted",
    "--muted-foreground",
    "--radius"
  ],
  "dependencies": [],
  "registryDependencies": [
    "avatar",
    "button",
    "blur-fade",
    "text-highlighter",
    "tweet-card"
  ],
  "files": [
    {
      "name": "testimonials-grid",
      "source": "src/blocks/testimonials-grid.tsx",
      "target": "components/blocks/testimonials-grid.tsx",
      "type": "registry:block"
    }
  ],
  "composition": {
    "contentSlots": [],
    "childComponents": [
      {
        "name": "avatar"
      },
      {
        "name": "button"
      },
      {
        "name": "blur-fade"
      },
      {
        "name": "text-highlighter"
      },
      {
        "name": "tweet-card"
      }
    ]
  },
  "standards": {
    "purpose": "Let real customers make the case in their own words.",
    "useWhen": [
      "Named customers gave quotable, specific praise."
    ],
    "doNotUseWhen": [
      "No customer agreed to be quoted — never fabricate testimonials."
    ],
    "rules": [
      {
        "id": "testimonials-grid-named-source",
        "severity": "error",
        "check": "Every quote carries a named source and role."
      },
      {
        "id": "testimonials-grid-real-company-marks",
        "severity": "error",
        "check": "Company marks shown beside a quote belong to the customer being quoted."
      }
    ]
  }
}
