{
  "name": "billing-1",
  "title": "Current Plan Summary Card",
  "description": "Current-plan billing card with monthly price, renewal date, a seat usage bar, and a dialog of radio tiers for switching plans.",
  "category": "application",
  "manifestVersion": 1,
  "block": true,
  "slots": [],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [
    "--background",
    "--foreground",
    "--muted-foreground"
  ],
  "dependencies": [
    "sonner"
  ],
  "registryDependencies": [
    "alert-dialog",
    "badge",
    "button",
    "card",
    "field",
    "progress",
    "radio-group",
    "separator"
  ],
  "files": [
    {
      "name": "billing-1",
      "source": "src/blocks/billing-1.tsx",
      "target": "components/blocks/billing-1.tsx",
      "type": "registry:block"
    },
    {
      "name": "shared/icon-placeholder",
      "source": "src/blocks/shared/icon-placeholder.tsx",
      "target": "components/blocks/shared/icon-placeholder.tsx",
      "type": "registry:lib"
    }
  ],
  "composition": {
    "contentSlots": [],
    "childComponents": [
      {
        "name": "alert-dialog"
      },
      {
        "name": "badge"
      },
      {
        "name": "button"
      },
      {
        "name": "card"
      },
      {
        "name": "field"
      },
      {
        "name": "progress"
      },
      {
        "name": "radio-group"
      },
      {
        "name": "separator"
      }
    ]
  },
  "standards": {
    "purpose": "Tell someone what they pay for, what they have used, and how to change it.",
    "useWhen": [
      "The account has a plan, invoices, or metered usage."
    ],
    "doNotUseWhen": [
      "The product is free and has no account billing."
    ],
    "rules": [
      {
        "id": "billing-1-currency-interval",
        "severity": "error",
        "check": "Amounts state their currency and billing interval."
      },
      {
        "id": "billing-1-destructive-confirmation",
        "severity": "error",
        "check": "Cancelling, removing a card, or changing plan requires confirmation that names the consequence."
      },
      {
        "id": "billing-1-no-card-data",
        "severity": "error",
        "check": "Never render a full card number; show brand and last four only."
      },
      {
        "id": "billing-1-usage-honesty",
        "severity": "warning",
        "check": "Usage meters state their limit and reset date and never show fabricated usage."
      }
    ]
  }
}
