{
  "name": "auth-3",
  "title": "Sign-Up With Plan Sidebar",
  "description": "Sign-up form paired with a plan sidebar listing Free, Pro, and Team tiers, first and last name fields, and a terms checkbox gating submit.",
  "category": "application",
  "manifestVersion": 1,
  "block": true,
  "slots": [],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [
    "--background",
    "--border",
    "--border-width",
    "--card",
    "--foreground",
    "--muted",
    "--muted-foreground",
    "--radius"
  ],
  "dependencies": [
    "sonner",
    "zod"
  ],
  "registryDependencies": [
    "badge",
    "button",
    "card",
    "checkbox",
    "field",
    "input",
    "label",
    "separator"
  ],
  "files": [
    {
      "name": "auth-3",
      "source": "src/blocks/auth-3.tsx",
      "target": "components/blocks/auth-3.tsx",
      "type": "registry:block"
    },
    {
      "name": "shared/icon-placeholder",
      "source": "src/blocks/shared/icon-placeholder.tsx",
      "target": "components/blocks/shared/icon-placeholder.tsx",
      "type": "registry:lib"
    }
  ],
  "composition": {
    "contentSlots": [],
    "childComponents": [
      {
        "name": "badge"
      },
      {
        "name": "button"
      },
      {
        "name": "card"
      },
      {
        "name": "checkbox"
      },
      {
        "name": "field"
      },
      {
        "name": "input"
      },
      {
        "name": "label"
      },
      {
        "name": "separator"
      }
    ]
  },
  "standards": {
    "purpose": "Collect the minimum needed to create an account and set expectations up front.",
    "useWhen": [
      "A new user is creating an account."
    ],
    "doNotUseWhen": [
      "The user is signing in to an existing account."
    ],
    "rules": [
      {
        "id": "auth-3-minimum-fields",
        "severity": "warning",
        "check": "Ask only for what the account needs to function; extra profile data belongs in onboarding."
      },
      {
        "id": "auth-3-password-rules-upfront",
        "severity": "error",
        "check": "Password requirements are stated before submission and validated inline."
      },
      {
        "id": "auth-3-terms-acknowledgement",
        "severity": "error",
        "check": "Terms and privacy acknowledgement is present and required where legally needed."
      },
      {
        "id": "auth-3-labelled-fields",
        "severity": "error",
        "check": "Every input carries a visible label or aria-label; a placeholder alone does not label a field."
      }
    ]
  }
}
