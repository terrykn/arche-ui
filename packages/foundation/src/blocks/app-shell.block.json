{
  "name": "app-shell",
  "title": "App shell",
  "description": "The application frame: sidebar navigation, top bar with account menu, and a main content region.",
  "category": "application",
  "manifestVersion": 1,
  "block": true,
  "slots": [{ "name": "brand", "part": "text", "required": false }, { "name": "navItems", "part": "text-list", "required": true }, { "name": "userName", "part": "text", "required": false }, { "name": "main", "part": "media", "required": true }],
  "axes": { "sidebar": { "values": ["fixed", "collapsible"], "default": "fixed" } },
  "styleSurface": {},
  "tokensUsed": ["--background", "--border", "--border-width", "--card", "--foreground", "--muted-foreground", "--primary", "--primary-foreground", "--radius"],
  "dependencies": ["class-variance-authority"],
  "registryDependencies": ["utils", "button", "avatar", "dropdown-menu", "separator"],
  "files": [{ "name": "app-shell", "source": "src/blocks/app-shell.tsx", "target": "components/blocks/app-shell.tsx", "type": "registry:block" }],
  "composition": {
    "contentSlots": [{ "name": "brand", "kind": "text", "required": false }, { "name": "navItems", "kind": "text-list", "required": true }, { "name": "userName", "kind": "text", "required": false }, { "name": "main", "kind": "media", "required": true }],
    "childComponents": [{ "name": "button", "min": 1 }, { "name": "avatar", "min": 0, "max": 1 }, { "name": "dropdown-menu", "min": 0, "max": 1 }, { "name": "separator", "min": 0 }],
    "headingRole": "none",
    "landmark": "navigation"
  },
  "standards": { "purpose": "Frame every app view with one navigation and one account control.", "useWhen": ["An authenticated app needs persistent navigation."], "doNotUseWhen": ["Marketing pages need orientation, not app chrome (use site-header)."], "rules": [{ "id": "app-shell-one-nav", "severity": "error", "check": "One primary navigation per shell; views switch inside the main region, never by duplicating shells." }] }
}
