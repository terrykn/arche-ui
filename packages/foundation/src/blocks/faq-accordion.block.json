{
  "name": "faq-accordion",
  "title": "Centered FAQ accordion",
  "description": "Centered heading over an accordion of eight questions, closed by a contact row.",
  "category": "marketing",
  "manifestVersion": 1,
  "block": true,
  "slots": [],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [
    "--border-width",
    "--card",
    "--foreground",
    "--muted",
    "--muted-foreground",
    "--primary",
    "--radius",
    "--shadow-sm"
  ],
  "dependencies": [],
  "registryDependencies": [
    "accordion",
    "button",
    "avatar-circles",
    "blur-fade",
    "grid-pattern"
  ],
  "files": [
    {
      "name": "faq-accordion",
      "source": "src/blocks/faq-accordion.tsx",
      "target": "components/blocks/faq-accordion.tsx",
      "type": "registry:block"
    }
  ],
  "composition": {
    "contentSlots": [],
    "childComponents": [
      {
        "name": "accordion"
      },
      {
        "name": "button"
      },
      {
        "name": "avatar-circles"
      },
      {
        "name": "blur-fade"
      },
      {
        "name": "grid-pattern"
      }
    ]
  },
  "standards": {
    "purpose": "Answer the questions that block a decision, in the visitor's own words.",
    "useWhen": [
      "Recurring objections can be answered in two or three sentences."
    ],
    "doNotUseWhen": [
      "The answer needs a support conversation or legal review."
    ],
    "rules": [
      {
        "id": "faq-accordion-one-question-per-item",
        "severity": "error",
        "check": "Each accordion item holds one question and its answer."
      },
      {
        "id": "faq-accordion-answer-length",
        "severity": "warning",
        "check": "Answers stay under roughly 80 words; longer material belongs on its own page."
      },
      {
        "id": "faq-accordion-disclosure-semantics",
        "severity": "error",
        "check": "The trigger exposes aria-expanded and controls its panel."
      }
    ]
  }
}
