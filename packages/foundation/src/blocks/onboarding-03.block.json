{
  "name": "onboarding-03",
  "title": "Onboarding Steps with Progress",
  "description": "A onboarding steps with progress block.",
  "category": "application",
  "manifestVersion": 1,
  "block": true,
  "slots": [],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [
    "--background",
    "--border",
    "--border-width",
    "--card",
    "--foreground",
    "--muted",
    "--muted-foreground",
    "--primary",
    "--radius",
    "--ring"
  ],
  "dependencies": [
    "@tabler/icons-react"
  ],
  "registryDependencies": [
    "utils",
    "progress"
  ],
  "files": [
    {
      "name": "onboarding-03",
      "source": "src/blocks/onboarding-03.tsx",
      "target": "components/blocks/onboarding-03.tsx",
      "type": "registry:block"
    }
  ],
  "composition": {
    "contentSlots": [],
    "childComponents": [
      {
        "name": "progress"
      }
    ]
  },
  "standards": {
    "purpose": "Get a new user to their first meaningful outcome with the fewest blocking steps.",
    "useWhen": [
      "A new account needs setup before the product is useful."
    ],
    "doNotUseWhen": [
      "The user already completed setup."
    ],
    "rules": [
      {
        "id": "onboarding-03-progress-truth",
        "severity": "error",
        "check": "Progress reflects only completed, saved steps."
      },
      {
        "id": "onboarding-03-skippable",
        "severity": "warning",
        "check": "Non-essential steps can be skipped or dismissed."
      },
      {
        "id": "onboarding-03-resumable",
        "severity": "warning",
        "check": "Dismissed onboarding can be reopened from a stable location."
      }
    ]
  }
}
