{
  "name": "cta",
  "title": "CTA",
  "description": "A closing panel with one headline and one action: start, install, or talk to us.",
  "category": "marketing",
  "manifestVersion": 1,
  "block": true,
  "slots": [{ "name": "headline", "part": "text", "required": true }, { "name": "body", "part": "text", "required": false }, { "name": "action", "part": "actions", "required": true }],
  "axes": { "alignment": { "values": ["center", "left"], "default": "center" } },
  "styleSurface": {},
  "tokensUsed": ["--border", "--border-width", "--card", "--card-foreground", "--muted-foreground", "--radius"],
  "dependencies": ["class-variance-authority"],
  "registryDependencies": ["utils", "button"],
  "files": [{ "name": "cta", "source": "src/blocks/cta.tsx", "target": "components/blocks/cta.tsx", "type": "registry:block" }],
  "composition": {
    "contentSlots": [{ "name": "headline", "kind": "text", "required": true }, { "name": "body", "kind": "text", "required": false }, { "name": "action", "kind": "actions", "required": true, "max": 1 }],
    "childComponents": [{ "name": "button", "min": 1, "max": 1 }],
    "headingRole": "h2"
  },
  "standards": { "purpose": "Convert interest into exactly one next step.", "useWhen": ["The page earned an ask at its end."], "doNotUseWhen": ["The visitor already converted (post-signup surfaces)."], "rules": [{ "id": "cta-single-action", "severity": "error", "check": "Exactly one action; a closing panel never offers two competing next steps." }] }
}
