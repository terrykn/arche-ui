{
  "name": "settings-page",
  "title": "Settings page",
  "description": "Workspace settings: profile fields, notification switches, and one save action.",
  "category": "application",
  "manifestVersion": 1,
  "block": true,
  "slots": [{ "name": "title", "part": "text", "required": false }],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": ["--destructive", "--muted-foreground"],
  "dependencies": [],
  "registryDependencies": ["utils", "card", "label", "input", "switch", "button", "separator"],
  "files": [{ "name": "settings-page", "source": "src/blocks/settings-page.tsx", "target": "components/blocks/settings-page.tsx", "type": "registry:block" }],
  "composition": {
    "contentSlots": [{ "name": "title", "kind": "text", "required": false }],
    "childComponents": [{ "name": "card", "min": 1 }, { "name": "label", "min": 1 }, { "name": "input", "min": 1 }, { "name": "switch", "min": 1 }, { "name": "button", "min": 1, "max": 1 }, { "name": "separator", "min": 0 }],
    "headingRole": "h1"
  },
  "standards": { "purpose": "Change workspace preferences with immediate, legible feedback.", "useWhen": ["Preferences need a durable home."], "doNotUseWhen": ["A preference changes constantly — put it where it is used, not in settings."], "rules": [{ "id": "settings-one-save", "severity": "error", "check": "Exactly one save action; every field carries a real label and an inline error state." }] }
}
