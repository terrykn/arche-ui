{
  "name": "ai-03",
  "title": "AI Chat Compact Interface",
  "description": "A ai chat compact interface block.",
  "category": "application",
  "manifestVersion": 1,
  "block": true,
  "slots": [],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [
    "--accent",
    "--background",
    "--border",
    "--border-width",
    "--foreground",
    "--muted-foreground",
    "--popover",
    "--primary",
    "--radius"
  ],
  "dependencies": [
    "@tabler/icons-react"
  ],
  "registryDependencies": [
    "utils",
    "button",
    "dropdown-menu",
    "textarea"
  ],
  "files": [
    {
      "name": "ai-03",
      "source": "src/blocks/ai-03.tsx",
      "target": "components/blocks/ai-03.tsx",
      "type": "registry:block"
    }
  ],
  "composition": {
    "contentSlots": [],
    "childComponents": [
      {
        "name": "button"
      },
      {
        "name": "dropdown-menu"
      },
      {
        "name": "textarea"
      }
    ]
  },
  "standards": {
    "purpose": "Let a person hold a conversation with a model and see exactly what was sent.",
    "useWhen": [
      "An assistant answers in turns and context accumulates."
    ],
    "doNotUseWhen": [
      "A single form submission covers the need."
    ],
    "rules": [
      {
        "id": "ai-03-streaming-state",
        "severity": "warning",
        "check": "Streaming responses show progress and can be stopped."
      },
      {
        "id": "ai-03-error-recovery",
        "severity": "error",
        "check": "A failed turn shows a retry path and keeps the user's message."
      },
      {
        "id": "ai-03-composer-keyboard",
        "severity": "error",
        "check": "The composer has an accessible label, sends on Enter, and inserts a newline on Shift+Enter."
      }
    ]
  }
}
