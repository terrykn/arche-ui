{
  "name": "settings-3",
  "title": "Tabbed Account Billing Team",
  "description": "Tabbed settings page splitting Account profile fields, a Billing plan and payment method card, and a Team members table with roles.",
  "category": "application",
  "manifestVersion": 1,
  "block": true,
  "slots": [],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [
    "--border",
    "--border-width",
    "--foreground",
    "--muted",
    "--muted-foreground",
    "--primary",
    "--radius"
  ],
  "dependencies": [
    "sonner"
  ],
  "registryDependencies": [
    "avatar",
    "badge",
    "button",
    "card",
    "field",
    "input",
    "separator",
    "switch",
    "table",
    "tabs"
  ],
  "files": [
    {
      "name": "settings-3",
      "source": "src/blocks/settings-3.tsx",
      "target": "components/blocks/settings-3.tsx",
      "type": "registry:block"
    },
    {
      "name": "shared/icon-placeholder",
      "source": "src/blocks/shared/icon-placeholder.tsx",
      "target": "components/blocks/shared/icon-placeholder.tsx",
      "type": "registry:lib"
    }
  ],
  "composition": {
    "contentSlots": [],
    "childComponents": [
      {
        "name": "avatar"
      },
      {
        "name": "badge"
      },
      {
        "name": "button"
      },
      {
        "name": "card"
      },
      {
        "name": "field"
      },
      {
        "name": "input"
      },
      {
        "name": "separator"
      },
      {
        "name": "switch"
      },
      {
        "name": "table"
      },
      {
        "name": "tabs"
      }
    ]
  },
  "standards": {
    "purpose": "Let a user change their account safely, one section at a time.",
    "useWhen": [
      "An account has configurable profile, billing, or notification settings."
    ],
    "doNotUseWhen": [
      "The change is a one-off action rather than a stored preference."
    ],
    "rules": [
      {
        "id": "settings-3-save-model",
        "severity": "error",
        "check": "Each section states whether changes save immediately or on submit."
      },
      {
        "id": "settings-3-destructive-confirmation",
        "severity": "error",
        "check": "Destructive settings require confirmation naming the consequence."
      },
      {
        "id": "settings-3-unsaved-guard",
        "severity": "warning",
        "check": "Leaving a section with unsaved edits warns before discarding."
      }
    ]
  }
}
