{
  "name": "site-header",
  "title": "Site header",
  "description": "The site navbar: logo, link row, actions, and an optional account menu with a mobile collapse pattern. One per page.",
  "category": "marketing",
  "manifestVersion": 1,
  "block": true,
  "slots": [{ "name": "logo", "part": "text", "required": true }, { "name": "links", "part": "text-list", "required": true }, { "name": "actions", "part": "actions", "required": false }],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": ["--background", "--border", "--border-width", "--foreground", "--muted", "--muted-foreground", "--radius"],
  "dependencies": ["class-variance-authority"],
  "registryDependencies": ["utils", "navigation-menu", "button", "avatar", "dropdown-menu"],
  "files": [{ "name": "site-header", "source": "src/blocks/site-header.tsx", "target": "components/blocks/site-header.tsx", "type": "registry:block" }],
  "composition": {
    "contentSlots": [{ "name": "logo", "kind": "text", "required": true }, { "name": "links", "kind": "text-list", "required": true }, { "name": "actions", "kind": "actions", "required": false, "max": 2 }],
    "childComponents": [{ "name": "navigation-menu", "min": 1, "max": 1 }, { "name": "button", "min": 0, "max": 2 }, { "name": "avatar", "min": 0, "max": 1 }, { "name": "dropdown-menu", "min": 0, "max": 1 }],
    "headingRole": "none",
    "landmark": "banner"
  },
  "standards": { "purpose": "Orient visitors and route them to the page's key destinations.", "useWhen": ["A marketing or docs site needs persistent navigation."], "doNotUseWhen": ["An app shell already provides the primary navigation (use app-shell)."], "rules": [{ "id": "site-header-one-per-page", "severity": "error", "check": "Exactly one site header per page; it carries the banner landmark." }, { "id": "site-header-mobile-menu", "severity": "warning", "check": "Below the mobile breakpoint the link row collapses behind a menu trigger; links stay reachable by keyboard." }] }
}
