{
  "name": "file-upload-01",
  "title": "File Upload with Preview",
  "description": "A file upload with preview block.",
  "category": "application",
  "manifestVersion": 1,
  "block": true,
  "slots": [],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [
    "--background",
    "--border",
    "--border-width",
    "--foreground",
    "--muted",
    "--muted-foreground",
    "--primary",
    "--radius",
    "--shadow-md"
  ],
  "dependencies": [],
  "registryDependencies": [
    "utils",
    "button",
    "card",
    "input",
    "label",
    "select",
    "tooltip"
  ],
  "files": [
    {
      "name": "file-upload-01",
      "source": "src/blocks/file-upload-01.tsx",
      "target": "components/blocks/file-upload-01.tsx",
      "type": "registry:block"
    }
  ],
  "composition": {
    "contentSlots": [],
    "childComponents": [
      {
        "name": "button"
      },
      {
        "name": "card"
      },
      {
        "name": "input"
      },
      {
        "name": "label"
      },
      {
        "name": "select"
      },
      {
        "name": "tooltip"
      }
    ]
  },
  "standards": {
    "purpose": "Get a file from the user's device into the product with clear limits and progress.",
    "useWhen": [
      "The user supplies a document, image, or archive."
    ],
    "doNotUseWhen": [
      "The data is short structured text that belongs in a form field."
    ],
    "rules": [
      {
        "id": "file-upload-01-limits-before-selection",
        "severity": "error",
        "check": "Accepted types and size limits are stated before the user selects a file."
      },
      {
        "id": "file-upload-01-announce-progress",
        "severity": "error",
        "check": "Upload progress and completion are announced to assistive tech."
      },
      {
        "id": "file-upload-01-error-recovery",
        "severity": "error",
        "check": "A failed upload states the reason and offers retry without losing the other files."
      },
      {
        "id": "file-upload-01-keyboard-input",
        "severity": "error",
        "check": "The file input has an accessible label and works from the keyboard."
      }
    ]
  }
}
