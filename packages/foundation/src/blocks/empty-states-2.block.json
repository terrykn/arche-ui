{
  "name": "empty-states-2",
  "title": "Illustrated Inbox Panel",
  "description": "Empty inbox panel with a framed inbox illustration, a create-workspace dialog with a name field, a Learn More link, and a support footer.",
  "category": "application",
  "manifestVersion": 1,
  "block": true,
  "slots": [],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [
    "--background",
    "--border",
    "--border-width",
    "--card",
    "--foreground",
    "--muted",
    "--muted-foreground",
    "--radius"
  ],
  "dependencies": [
    "sonner"
  ],
  "registryDependencies": [
    "button",
    "dialog",
    "empty",
    "field",
    "input",
    "separator"
  ],
  "files": [
    {
      "name": "empty-states-2",
      "source": "src/blocks/empty-states-2.tsx",
      "target": "components/blocks/empty-states-2.tsx",
      "type": "registry:block"
    },
    {
      "name": "shared/icon-placeholder",
      "source": "src/blocks/shared/icon-placeholder.tsx",
      "target": "components/blocks/shared/icon-placeholder.tsx",
      "type": "registry:lib"
    }
  ],
  "composition": {
    "contentSlots": [],
    "childComponents": [
      {
        "name": "button"
      },
      {
        "name": "dialog"
      },
      {
        "name": "empty"
      },
      {
        "name": "field"
      },
      {
        "name": "input"
      },
      {
        "name": "separator"
      }
    ]
  },
  "standards": {
    "purpose": "Turn a blank surface into a next step instead of a dead end.",
    "useWhen": [
      "A list, table, or panel has no content to show."
    ],
    "doNotUseWhen": [
      "The surface is still loading — show a skeleton instead."
    ],
    "rules": [
      {
        "id": "empty-states-2-explain-why",
        "severity": "error",
        "check": "The state says why the surface is empty."
      },
      {
        "id": "empty-states-2-one-next-step",
        "severity": "warning",
        "check": "Offer one primary next step; secondary links stay subordinate."
      },
      {
        "id": "empty-states-2-distinct-from-loading",
        "severity": "error",
        "check": "Empty, loading, and error states are visually and textually distinct."
      }
    ]
  }
}
