{
  "name": "logos-grid",
  "title": "Logo grid",
  "description": "Bordered grid of customer logos with a cursor spotlight per cell, beside a heading and stories link.",
  "category": "marketing",
  "manifestVersion": 1,
  "block": true,
  "slots": [],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [
    "--background",
    "--border",
    "--border-width",
    "--brand",
    "--card",
    "--chart-3",
    "--font-mono",
    "--foreground",
    "--motion-normal",
    "--muted-foreground",
    "--primary",
    "--radius",
    "--ring"
  ],
  "dependencies": [],
  "registryDependencies": [
    "utils",
    "blur-fade",
    "spotlight-card"
  ],
  "files": [
    {
      "name": "logos-grid",
      "source": "src/blocks/logos-grid.tsx",
      "target": "components/blocks/logos-grid.tsx",
      "type": "registry:block"
    }
  ],
  "composition": {
    "contentSlots": [],
    "childComponents": [
      {
        "name": "blur-fade"
      },
      {
        "name": "spotlight-card"
      }
    ]
  },
  "standards": {
    "purpose": "Borrow credibility by showing organizations that actually use the product.",
    "useWhen": [
      "Named customers approved logo display."
    ],
    "doNotUseWhen": [
      "Logos are aspirational, unlicensed, or no longer customers."
    ],
    "rules": [
      {
        "id": "logos-grid-real-customers",
        "severity": "error",
        "check": "Every logo belongs to a current customer or an explicitly labeled partner."
      },
      {
        "id": "logos-grid-legible-at-size",
        "severity": "warning",
        "check": "Logos stay legible at small size and keep AA contrast against the section background."
      }
    ]
  }
}
