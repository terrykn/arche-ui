{
  "name": "site-footer",
  "title": "Site footer",
  "description": "The sitemap footer: link columns grouped by section plus a legal note. Carries the contentinfo landmark.",
  "category": "marketing",
  "manifestVersion": 1,
  "block": true,
  "slots": [
    {
      "name": "columns",
      "part": "records",
      "required": true
    },
    {
      "name": "note",
      "part": "text",
      "required": false
    }
  ],
  "axes": {
    "layout": {
      "values": [
        "extended",
        "compact"
      ],
      "default": "extended"
    }
  },
  "styleSurface": {},
  "tokensUsed": [
    "--border",
    "--border-width",
    "--foreground",
    "--muted-foreground"
  ],
  "dependencies": [
    "class-variance-authority"
  ],
  "registryDependencies": [
    "utils",
    "separator"
  ],
  "files": [
    {
      "name": "site-footer",
      "source": "src/blocks/site-footer.tsx",
      "target": "components/blocks/site-footer.tsx",
      "type": "registry:block"
    }
  ],
  "composition": {
    "contentSlots": [
      {
        "name": "columns",
        "kind": "records",
        "required": true
      },
      {
        "name": "note",
        "kind": "text",
        "required": false
      }
    ],
    "childComponents": [
      {
        "name": "separator",
        "min": 1,
        "max": 1
      }
    ],
    "headingRole": "none",
    "landmark": "contentinfo"
  },
  "standards": {
    "purpose": "Close the page with the full sitemap and zero dead ends.",
    "useWhen": [
      "Every page needs its way out and its legal line."
    ],
    "doNotUseWhen": [
      "A link has no destination \u00e2\u20ac\u201d dead links never ship."
    ],
    "rules": [
      {
        "id": "site-footer-no-dead-links",
        "severity": "error",
        "check": "Every footer link resolves to a real page; columns mirror the site IA."
      }
    ]
  }
}
