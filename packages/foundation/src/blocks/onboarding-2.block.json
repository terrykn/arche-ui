{
  "name": "onboarding-2",
  "title": "Three-Card Setup Steps",
  "description": "Onboarding laid out as three numbered step cards for importing data, inviting teammates, and customizing the workspace, each toggling to complete.",
  "category": "application",
  "manifestVersion": 1,
  "block": true,
  "slots": [],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [
    "--background",
    "--foreground",
    "--muted",
    "--muted-foreground",
    "--primary",
    "--primary-foreground",
    "--radius"
  ],
  "dependencies": [],
  "registryDependencies": [
    "utils",
    "button",
    "card",
    "progress"
  ],
  "files": [
    {
      "name": "onboarding-2",
      "source": "src/blocks/onboarding-2.tsx",
      "target": "components/blocks/onboarding-2.tsx",
      "type": "registry:block"
    },
    {
      "name": "shared/icon-placeholder",
      "source": "src/blocks/shared/icon-placeholder.tsx",
      "target": "components/blocks/shared/icon-placeholder.tsx",
      "type": "registry:lib"
    }
  ],
  "composition": {
    "contentSlots": [],
    "childComponents": [
      {
        "name": "button"
      },
      {
        "name": "card"
      },
      {
        "name": "progress"
      }
    ]
  },
  "standards": {
    "purpose": "Get a new user to their first meaningful outcome with the fewest blocking steps.",
    "useWhen": [
      "A new account needs setup before the product is useful."
    ],
    "doNotUseWhen": [
      "The user already completed setup."
    ],
    "rules": [
      {
        "id": "onboarding-2-progress-truth",
        "severity": "error",
        "check": "Progress reflects only completed, saved steps."
      },
      {
        "id": "onboarding-2-skippable",
        "severity": "warning",
        "check": "Non-essential steps can be skipped or dismissed."
      },
      {
        "id": "onboarding-2-resumable",
        "severity": "warning",
        "check": "Dismissed onboarding can be reopened from a stable location."
      }
    ]
  }
}
