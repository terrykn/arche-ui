{
  "name": "cta-newsletter",
  "title": "Newsletter sign-up",
  "description": "Newsletter card over a glowing dot grid with a labelled email field, subscriber avatars and a privacy note.",
  "category": "marketing",
  "manifestVersion": 1,
  "block": true,
  "slots": [],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [
    "--background",
    "--border-width",
    "--brand",
    "--card",
    "--foreground",
    "--muted-foreground",
    "--primary",
    "--radius",
    "--ring",
    "--shadow-lg",
    "--shadow-sm"
  ],
  "dependencies": [],
  "registryDependencies": [
    "button",
    "input",
    "label",
    "avatar-circles",
    "dotted-glow-background"
  ],
  "files": [
    {
      "name": "cta-newsletter",
      "source": "src/blocks/cta-newsletter.tsx",
      "target": "components/blocks/cta-newsletter.tsx",
      "type": "registry:block"
    }
  ],
  "composition": {
    "contentSlots": [],
    "childComponents": [
      {
        "name": "button"
      },
      {
        "name": "input"
      },
      {
        "name": "label"
      },
      {
        "name": "avatar-circles"
      },
      {
        "name": "dotted-glow-background"
      }
    ]
  },
  "standards": {
    "purpose": "Close a section by offering one clear next step.",
    "useWhen": [
      "The reader already has enough context to act."
    ],
    "doNotUseWhen": [
      "The action is unavailable, or the surface is inside the product."
    ],
    "rules": [
      {
        "id": "cta-newsletter-one-primary-action",
        "severity": "error",
        "check": "One primary action; any secondary action is visually subordinate."
      },
      {
        "id": "cta-newsletter-concrete-label",
        "severity": "warning",
        "check": "The action label names the outcome (start trial, book a demo), never a bare 'Submit'."
      },
      {
        "id": "cta-newsletter-aa-contrast",
        "severity": "error",
        "check": "Action text and background meet WCAG AA in both light and dark themes."
      }
    ]
  }
}
