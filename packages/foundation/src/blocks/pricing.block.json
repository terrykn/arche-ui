{
  "name": "pricing",
  "title": "Pricing",
  "description": "Tier cards with prices, feature lists, and one highlighted tier. Two to four tiers.",
  "category": "marketing",
  "manifestVersion": 1,
  "block": true,
  "slots": [{ "name": "headline", "part": "text", "required": false }, { "name": "tiers", "part": "records", "required": true }],
  "axes": { "tierCount": { "values": ["two", "three", "four"], "default": "three" } },
  "styleSurface": {},
  "tokensUsed": ["--foreground", "--muted-foreground", "--primary"],
  "dependencies": ["class-variance-authority"],
  "registryDependencies": ["utils", "card", "button", "badge", "separator"],
  "files": [{ "name": "pricing", "source": "src/blocks/pricing.tsx", "target": "components/blocks/pricing.tsx", "type": "registry:block" }],
  "composition": {
    "contentSlots": [{ "name": "headline", "kind": "text", "required": false }, { "name": "tiers", "kind": "records", "required": true }],
    "childComponents": [{ "name": "card", "min": 2, "max": 4 }, { "name": "button", "min": 2, "max": 4 }, { "name": "badge", "min": 0, "max": 1 }, { "name": "separator", "min": 0 }],
    "headingRole": "h2"
  },
  "standards": { "purpose": "State what each tier costs and what it includes, honestly.", "useWhen": ["The product has priced tiers to compare."], "doNotUseWhen": ["Prices are not final — never publish placeholder prices."], "rules": [{ "id": "pricing-max-four-tiers", "severity": "error", "check": "Two to four tiers; more tiers need a comparison table, not cards." }, { "id": "pricing-one-highlight", "severity": "warning", "check": "At most one tier is highlighted as recommended." }] }
}
