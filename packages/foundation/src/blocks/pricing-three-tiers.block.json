        "id": "pricing-three-tiers-two-to-four-tiers",
        "severity": "error",
        "check": "Two to four tiers; more requires a comparison table rather than plan cards."
      },
      {
        "id": "pricing-three-tiers-one-highlight",
        "severity": "warning",
        "check": "At most one tier is featured as recommended."
      },
      {
        "id": "pricing-three-tiers-currency-interval",
        "severity": "error",
        "check": "Every price states its currency and billing interval, and an interval switch updates all prices."
