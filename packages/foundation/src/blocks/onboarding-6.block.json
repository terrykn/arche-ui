{
  "name": "onboarding-6",
  "title": "Dismissible Getting Started Widget",
  "description": "Compact getting-started widget with a dismiss button, progress bar, and a five-step checklist showing completed steps struck through.",
  "category": "application",
  "manifestVersion": 1,
  "block": true,
  "slots": [],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [
    "--background",
    "--border",
    "--border-width",
    "--foreground",
    "--muted",
    "--muted-foreground",
    "--radius"
  ],
  "dependencies": [],
  "registryDependencies": [
    "utils",
    "progress"
  ],
  "files": [
    {
      "name": "onboarding-6",
      "source": "src/blocks/onboarding-6.tsx",
      "target": "components/blocks/onboarding-6.tsx",
      "type": "registry:block"
    },
    {
      "name": "shared/icon-placeholder",
      "source": "src/blocks/shared/icon-placeholder.tsx",
      "target": "components/blocks/shared/icon-placeholder.tsx",
      "type": "registry:lib"
    }
  ],
  "composition": {
    "contentSlots": [],
    "childComponents": [
      {
        "name": "progress"
      }
    ]
  },
  "standards": {
    "purpose": "Get a new user to their first meaningful outcome with the fewest blocking steps.",
    "useWhen": [
      "A new account needs setup before the product is useful."
    ],
    "doNotUseWhen": [
      "The user already completed setup."
    ],
    "rules": [
      {
        "id": "onboarding-6-progress-truth",
        "severity": "error",
        "check": "Progress reflects only completed, saved steps."
      },
      {
        "id": "onboarding-6-skippable",
        "severity": "warning",
        "check": "Non-essential steps can be skipped or dismissed."
      },
      {
        "id": "onboarding-6-resumable",
        "severity": "warning",
        "check": "Dismissed onboarding can be reopened from a stable location."
      }
    ]
  }
}
