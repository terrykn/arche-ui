{
  "name": "settings-4",
  "title": "Section Nav Settings Layout",
  "description": "Settings layout with a left section nav (Profile, Account, Notifications, Billing) that swaps the active section's form cards beside it.",
  "category": "application",
  "manifestVersion": 1,
  "block": true,
  "slots": [],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [
    "--background",
    "--border",
    "--border-width",
    "--foreground",
    "--muted",
    "--muted-foreground",
    "--radius"
  ],
  "dependencies": [],
  "registryDependencies": [
    "utils",
    "avatar",
    "button",
    "field",
    "input",
    "separator",
    "switch"
  ],
  "files": [
    {
      "name": "settings-4",
      "source": "src/blocks/settings-4.tsx",
      "target": "components/blocks/settings-4.tsx",
      "type": "registry:block"
    },
    {
      "name": "shared/icon-placeholder",
      "source": "src/blocks/shared/icon-placeholder.tsx",
      "target": "components/blocks/shared/icon-placeholder.tsx",
      "type": "registry:lib"
    }
  ],
  "composition": {
    "contentSlots": [],
    "childComponents": [
      {
        "name": "avatar"
      },
      {
        "name": "button"
      },
      {
        "name": "field"
      },
      {
        "name": "input"
      },
      {
        "name": "separator"
      },
      {
        "name": "switch"
      }
    ]
  },
  "standards": {
    "purpose": "Let a user change their account safely, one section at a time.",
    "useWhen": [
      "An account has configurable profile, billing, or notification settings."
    ],
    "doNotUseWhen": [
      "The change is a one-off action rather than a stored preference."
    ],
    "rules": [
      {
        "id": "settings-4-save-model",
        "severity": "error",
        "check": "Each section states whether changes save immediately or on submit."
      },
      {
        "id": "settings-4-destructive-confirmation",
        "severity": "error",
        "check": "Destructive settings require confirmation naming the consequence."
      },
      {
        "id": "settings-4-unsaved-guard",
        "severity": "warning",
        "check": "Leaving a section with unsaved edits warns before discarding."
      }
    ]
  }
}
