{
  "name": "calendar-1",
  "title": "Month Grid With Day Detail",
  "description": "Month calendar grid with previous and next navigation, a Today shortcut, selectable days, and a detail panel for the chosen day's event.",
  "category": "application",
  "manifestVersion": 1,
  "block": true,
  "slots": [],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [
    "--background",
    "--border",
    "--border-width",
    "--card",
    "--card-foreground",
    "--foreground",
    "--muted",
    "--muted-foreground",
    "--primary",
    "--primary-foreground",
    "--radius",
    "--ring"
  ],
  "dependencies": [],
  "registryDependencies": [
    "utils",
    "badge",
    "button",
    "separator"
  ],
  "files": [
    {
      "name": "calendar-1",
      "source": "src/blocks/calendar-1.tsx",
      "target": "components/blocks/calendar-1.tsx",
      "type": "registry:block"
    },
    {
      "name": "shared/icon-placeholder",
      "source": "src/blocks/shared/icon-placeholder.tsx",
      "target": "components/blocks/shared/icon-placeholder.tsx",
      "type": "registry:lib"
    }
  ],
  "composition": {
    "contentSlots": [],
    "childComponents": [
      {
        "name": "badge"
      },
      {
        "name": "button"
      },
      {
        "name": "separator"
      }
    ]
  },
  "standards": {
    "purpose": "Place events on a time grid a person can scan and navigate.",
    "useWhen": [
      "Content is tied to dates and times."
    ],
    "doNotUseWhen": [
      "Items have no date, or only a single upcoming date matters (use a list)."
    ],
    "rules": [
      {
        "id": "calendar-1-accessible-grid",
        "severity": "error",
        "check": "Day cells are gridcells or buttons whose accessible name includes the full date."
      },
      {
        "id": "calendar-1-keyboard-navigation",
        "severity": "warning",
        "check": "Arrow keys move between days and Enter selects."
      },
      {
        "id": "calendar-1-empty-day-state",
        "severity": "warning",
        "check": "Selecting a day with no events shows an explicit empty state."
      }
    ]
  }
}
