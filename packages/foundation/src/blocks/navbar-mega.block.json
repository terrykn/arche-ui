{
  "name": "navbar-mega",
  "title": "Mega menu navbar",
  "description": "Top bar with a keyboard-accessible Product mega menu, search, sign-in and a slide-over mobile menu.",
  "category": "marketing",
  "manifestVersion": 1,
  "block": true,
  "slots": [],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [
    "--background",
    "--border-width",
    "--font-mono",
    "--foreground",
    "--motion-normal",
    "--muted",
    "--muted-foreground",
    "--primary",
    "--primary-foreground",
    "--radius",
    "--ring",
    "--shadow-sm",
    "--shadow-xl"
  ],
  "dependencies": [],
  "registryDependencies": [
    "accordion",
    "button",
    "dropdown-menu",
    "sheet"
  ],
  "files": [
    {
      "name": "navbar-mega",
      "source": "src/blocks/navbar-mega.tsx",
      "target": "components/blocks/navbar-mega.tsx",
      "type": "registry:block"
    }
  ],
  "composition": {
    "contentSlots": [],
    "childComponents": [
      {
        "name": "accordion"
      },
      {
        "name": "button"
      },
      {
        "name": "dropdown-menu"
      },
      {
        "name": "sheet"
      }
    ]
  },
  "standards": {
    "purpose": "Give visitors one persistent, keyboard-reachable way to move through the site.",
    "useWhen": [
      "The site has more than one destination."
    ],
    "doNotUseWhen": [
      "A single-screen embed where navigation would be noise."
    ],
    "rules": [
      {
        "id": "navbar-mega-single-header",
        "severity": "error",
        "check": "One header landmark per page."
      },
      {
        "id": "navbar-mega-keyboard-operable",
        "severity": "error",
        "check": "Every menu opens, closes, and is traversable by keyboard; focus returns to the trigger on close."
      },
      {
        "id": "navbar-mega-mobile-disclosure",
        "severity": "warning",
        "check": "Below the small breakpoint the nav collapses to a disclosure, never an overflowing row."
      }
    ]
  }
}
