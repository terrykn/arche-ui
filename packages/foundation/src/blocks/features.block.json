{
  "name": "features",
  "title": "Features",
  "description": "A capability grid: eyebrow, headline, and feature cards with icons. Grid, split, or bento composition.",
  "category": "marketing",
  "manifestVersion": 1,
  "block": true,
  "slots": [{ "name": "eyebrow", "part": "text", "required": false }, { "name": "headline", "part": "text", "required": false }, { "name": "items", "part": "records", "required": true }],
  "axes": { "layout": { "values": ["grid", "split", "bento"], "default": "grid" } },
  "styleSurface": {},
  "tokensUsed": ["--foreground", "--primary", "--primary-foreground", "--radius"],
  "dependencies": ["class-variance-authority", "lucide-react"],
  "registryDependencies": ["utils", "card", "badge"],
  "files": [{ "name": "features", "source": "src/blocks/features.tsx", "target": "components/blocks/features.tsx", "type": "registry:block" }],
  "composition": {
    "contentSlots": [{ "name": "eyebrow", "kind": "text", "required": false }, { "name": "headline", "kind": "text", "required": false }, { "name": "items", "kind": "records", "required": true }],
    "childComponents": [{ "name": "card", "min": 1 }, { "name": "badge", "min": 0, "max": 1 }],
    "headingRole": "h2"
  },
  "standards": { "purpose": "Explain what the product does in scannable capability cards.", "useWhen": ["Visitors need the capability tour before pricing."], "doNotUseWhen": ["A single capability needs depth — write a section, not a grid cell."], "rules": [{ "id": "features-one-job", "severity": "info", "check": "One job per section: capability cards only, no pricing or testimonials mixed in." }, { "id": "features-icon-consistency", "severity": "warning", "check": "One Lucide icon set, one size and stroke, across all cards." }] }
}
