{
  "name": "testimonials-marquee",
  "title": "Testimonial marquee",
  "description": "Two rows of review cards scrolling in opposite directions, with faded edges and pause on hover or focus.",
  "category": "marketing",
  "manifestVersion": 1,
  "block": true,
  "slots": [],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [
    "--border-width",
    "--brand",
    "--brand-foreground",
    "--card",
    "--card-foreground",
    "--foreground",
    "--muted-foreground",
    "--radius",
    "--shadow-sm"
  ],
  "dependencies": [],
  "registryDependencies": [
    "utils",
    "avatar",
    "blur-fade",
    "marquee"
  ],
  "files": [
    {
      "name": "testimonials-marquee",
      "source": "src/blocks/testimonials-marquee.tsx",
      "target": "components/blocks/testimonials-marquee.tsx",
      "type": "registry:block"
    }
  ],
  "composition": {
    "contentSlots": [],
    "childComponents": [
      {
        "name": "avatar"
      },
      {
        "name": "blur-fade"
      },
      {
        "name": "marquee"
      }
    ]
  },
  "standards": {
    "purpose": "Let real customers make the case in their own words.",
    "useWhen": [
      "Named customers gave quotable, specific praise."
    ],
    "doNotUseWhen": [
      "No customer agreed to be quoted — never fabricate testimonials."
    ],
    "rules": [
      {
        "id": "testimonials-marquee-named-source",
        "severity": "error",
        "check": "Every quote carries a named source and role."
      },
      {
        "id": "testimonials-marquee-real-company-marks",
        "severity": "error",
        "check": "Company marks shown beside a quote belong to the customer being quoted."
      }
    ]
  }
}
