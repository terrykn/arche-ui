{
  "name": "dialog-11",
  "title": "Dialog Multi-Step Wizard",
  "description": "A dialog multi-step wizard block.",
  "category": "application",
  "manifestVersion": 1,
  "block": true,
  "slots": [],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [
    "--border-width",
    "--foreground",
    "--muted",
    "--muted-foreground",
    "--radius"
  ],
  "dependencies": [],
  "registryDependencies": [
    "button",
    "dialog",
    "label",
    "select",
    "separator"
  ],
  "files": [
    {
      "name": "dialog-11",
      "source": "src/blocks/dialog-11.tsx",
      "target": "components/blocks/dialog-11.tsx",
      "type": "registry:block"
    }
  ],
  "composition": {
    "contentSlots": [],
    "childComponents": [
      {
        "name": "button"
      },
      {
        "name": "dialog"
      },
      {
        "name": "label"
      },
      {
        "name": "select"
      },
      {
        "name": "separator"
      }
    ]
  },
  "standards": {
    "purpose": "Interrupt for one decision that cannot be handled inline.",
    "useWhen": [
      "The user must confirm, choose, or enter something before continuing."
    ],
    "doNotUseWhen": [
      "The content is long-form or navigational — use a page or sheet."
    ],
    "rules": [
      {
        "id": "dialog-11-requires-title",
        "severity": "error",
        "check": "Every dialog has an accessible title; an icon alone is not a label."
      },
      {
        "id": "dialog-11-destructive-alert",
        "severity": "error",
        "check": "Destructive confirmations use an alert dialog with a clearly named confirm action."
      },
      {
        "id": "dialog-11-no-nesting",
        "severity": "error",
        "check": "A dialog never opens another dialog."
      },
      {
        "id": "dialog-11-focus-management",
        "severity": "error",
        "check": "Focus moves into the dialog on open and returns to the trigger on close."
      }
    ]
  }
}
