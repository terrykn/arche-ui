{
  "name": "newsletter-signup",
  "title": "Newsletter signup",
  "description": "A changelog-digest signup: headline, email field, and one subscribe action with inline validation.",
  "category": "marketing",
  "manifestVersion": 1,
  "block": true,
  "slots": [
    {
      "name": "headline",
      "part": "text",
      "required": false
    },
    {
      "name": "subhead",
      "part": "text",
      "required": false
    }
  ],
  "axes": {
    "layout": {
      "values": [
        "centered",
        "split"
      ],
      "default": "centered"
    }
  },
  "styleSurface": {},
  "tokensUsed": [
    "--border",
    "--border-width",
    "--card",
    "--destructive",
    "--foreground",
    "--muted-foreground",
    "--radius"
  ],
  "dependencies": [
    "class-variance-authority"
  ],
  "registryDependencies": [
    "utils",
    "label",
    "input",
    "button"
  ],
  "files": [
    {
      "name": "newsletter-signup",
      "source": "src/blocks/newsletter-signup.tsx",
      "target": "components/blocks/newsletter-signup.tsx",
      "type": "registry:block"
    }
  ],
  "composition": {
    "contentSlots": [
      {
        "name": "headline",
        "kind": "text",
        "required": false
      },
      {
        "name": "subhead",
        "kind": "text",
        "required": false
      }
    ],
    "childComponents": [
      {
        "name": "label",
        "min": 1,
        "max": 1
      },
      {
        "name": "input",
        "min": 1,
        "max": 1
      },
      {
        "name": "button",
        "min": 1,
        "max": 1
      }
    ],
    "headingRole": "h2"
  },
  "standards": {
    "purpose": "Collect emails for a digest people actually open.",
    "useWhen": [
      "A regular digest exists to subscribe to."
    ],
    "doNotUseWhen": [
      "There is no publishing cadence \u00e2\u20ac\u201d never collect emails for vapor."
    ],
    "rules": [
      {
        "id": "newsletter-labels-email",
        "severity": "error",
        "check": "The email field carries a real label and an inline error state; placeholder text is never the label."
      }
    ]
  }
}
