{
  "name": "sidebar-1",
  "title": "Dashboard Rail With Stats",
  "description": "App layout with a collapsible icon sidebar of grouped navigation beside a dashboard inset of stat tiles and a project listing.",
  "category": "application",
  "manifestVersion": 1,
  "block": true,
  "slots": [],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [
    "--border",
    "--border-width",
    "--card",
    "--foreground",
    "--motion-fast",
    "--muted",
    "--muted-foreground",
    "--primary",
    "--radius",
    "--shadow-sm"
  ],
  "dependencies": [],
  "registryDependencies": [
    "avatar",
    "button",
    "dropdown-menu",
    "input",
    "sidebar"
  ],
  "files": [
    {
      "name": "sidebar-1",
      "source": "src/blocks/sidebar-1.tsx",
      "target": "components/blocks/sidebar-1.tsx",
      "type": "registry:block"
    },
    {
      "name": "shared/icon-placeholder",
      "source": "src/blocks/shared/icon-placeholder.tsx",
      "target": "components/blocks/shared/icon-placeholder.tsx",
      "type": "registry:lib"
    }
  ],
  "composition": {
    "contentSlots": [],
    "childComponents": [
      {
        "name": "avatar"
      },
      {
        "name": "button"
      },
      {
        "name": "dropdown-menu"
      },
      {
        "name": "input"
      },
      {
        "name": "sidebar"
      }
    ]
  },
  "standards": {
    "purpose": "Keep primary navigation reachable while the main surface scrolls.",
    "useWhen": [
      "The product has several top-level areas used repeatedly."
    ],
    "doNotUseWhen": [
      "Navigation is a temporary overlay rather than a persistent frame."
    ],
    "rules": [
      {
        "id": "sidebar-1-current-page",
        "severity": "error",
        "check": "The active item is marked with aria-current, not by color alone."
      },
      {
        "id": "sidebar-1-disclosure-keyboard",
        "severity": "error",
        "check": "Disclosure triggers are buttons with aria-expanded, reachable in order."
      },
      {
        "id": "sidebar-1-persist-collapse",
        "severity": "warning",
        "check": "Collapsed state persists across navigation."
      },
      {
        "id": "sidebar-1-mobile-sheet",
        "severity": "warning",
        "check": "Below the small breakpoint the sidebar becomes a sheet or drawer."
      }
    ]
  }
}
