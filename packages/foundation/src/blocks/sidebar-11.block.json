{
  "name": "sidebar-11",
  "title": "Sidebar 11",
  "description": "A sidebar with a collapsible file tree.",
  "category": "application",
  "manifestVersion": 1,
  "block": true,
  "slots": [],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [
    "--border-width",
    "--muted",
    "--radius"
  ],
  "dependencies": [],
  "registryDependencies": [
    "collapsible",
    "sidebar",
    "breadcrumb",
    "separator"
  ],
  "files": [
    {
      "name": "sidebar-11",
      "source": "src/blocks/sidebar-11.tsx",
      "target": "components/blocks/sidebar-11.tsx",
      "type": "registry:block"
    }
  ],
  "composition": {
    "contentSlots": [],
    "childComponents": [
      {
        "name": "collapsible"
      },
      {
        "name": "sidebar"
      },
      {
        "name": "breadcrumb"
      },
      {
        "name": "separator"
      }
    ]
  },
  "standards": {
    "purpose": "Keep primary navigation reachable while the main surface scrolls.",
    "useWhen": [
      "The product has several top-level areas used repeatedly."
    ],
    "doNotUseWhen": [
      "Navigation is a temporary overlay rather than a persistent frame."
    ],
    "rules": [
      {
        "id": "sidebar-11-current-page",
        "severity": "error",
        "check": "The active item is marked with aria-current, not by color alone."
      },
      {
        "id": "sidebar-11-disclosure-keyboard",
        "severity": "error",
        "check": "Disclosure triggers are buttons with aria-expanded, reachable in order."
      },
      {
        "id": "sidebar-11-persist-collapse",
        "severity": "warning",
        "check": "Collapsed state persists across navigation."
      },
      {
        "id": "sidebar-11-mobile-sheet",
        "severity": "warning",
        "check": "Below the small breakpoint the sidebar becomes a sheet or drawer."
      }
    ]
  }
}
