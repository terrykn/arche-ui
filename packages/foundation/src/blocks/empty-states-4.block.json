{
  "name": "empty-states-4",
  "title": "Failed Load Error",
  "description": "Error empty state for data that failed to load, with a destructive alert icon plus Try Again and contact support actions.",
  "category": "application",
  "manifestVersion": 1,
  "block": true,
  "slots": [],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [
    "--border",
    "--border-width",
    "--card",
    "--destructive",
    "--foreground",
    "--muted",
    "--radius"
  ],
  "dependencies": [
    "sonner"
  ],
  "registryDependencies": [
    "button",
    "empty"
  ],
  "files": [
    {
      "name": "empty-states-4",
      "source": "src/blocks/empty-states-4.tsx",
      "target": "components/blocks/empty-states-4.tsx",
      "type": "registry:block"
    },
    {
      "name": "shared/icon-placeholder",
      "source": "src/blocks/shared/icon-placeholder.tsx",
      "target": "components/blocks/shared/icon-placeholder.tsx",
      "type": "registry:lib"
    }
  ],
  "composition": {
    "contentSlots": [],
    "childComponents": [
      {
        "name": "button"
      },
      {
        "name": "empty"
      }
    ]
  },
  "standards": {
    "purpose": "Turn a blank surface into a next step instead of a dead end.",
    "useWhen": [
      "A list, table, or panel has no content to show."
    ],
    "doNotUseWhen": [
      "The surface is still loading — show a skeleton instead."
    ],
    "rules": [
      {
        "id": "empty-states-4-explain-why",
        "severity": "error",
        "check": "The state says why the surface is empty."
      },
      {
        "id": "empty-states-4-one-next-step",
        "severity": "warning",
        "check": "Offer one primary next step; secondary links stay subordinate."
      },
      {
        "id": "empty-states-4-distinct-from-loading",
        "severity": "error",
        "check": "Empty, loading, and error states are visually and textually distinct."
      }
    ]
  }
}
