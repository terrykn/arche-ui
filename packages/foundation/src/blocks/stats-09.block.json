{
  "name": "stats-09",
  "title": "Stats with Progress",
  "description": "A stats with progress block.",
  "category": "application",
  "manifestVersion": 1,
  "block": true,
  "slots": [],
  "axes": {},
  "styleSurface": {},
  "tokensUsed": [
    "--foreground",
    "--muted-foreground",
    "--primary"
  ],
  "dependencies": [],
  "registryDependencies": [
    "card",
    "progress"
  ],
  "files": [
    {
      "name": "stats-09",
      "source": "src/blocks/stats-09.tsx",
      "target": "components/blocks/stats-09.tsx",
      "type": "registry:block"
    }
  ],
  "composition": {
    "contentSlots": [],
    "childComponents": [
      {
        "name": "card"
      },
      {
        "name": "progress"
      }
    ]
  },
  "standards": {
    "purpose": "Summarize the few numbers that tell someone how things are going.",
    "useWhen": [
      "A dashboard opens with a small set of decision-relevant metrics."
    ],
    "doNotUseWhen": [
      "The numbers are the page's main content and need their own charts or table."
    ],
    "rules": [
      {
        "id": "stats-09-units-and-window",
        "severity": "error",
        "check": "Every metric states its unit and time window; deltas name the comparison period."
      },
      {
        "id": "stats-09-no-fake-live",
        "severity": "error",
        "check": "Numbers presented as live come from real data; placeholders are labeled."
      },
      {
        "id": "stats-09-one-highlight",
        "severity": "warning",
        "check": "At most one metric is visually emphasized."
      }
    ]
  }
}
