{
  "name": "auth-login",
  "title": "Login",
  "description": "The sign-in card: email, password with visibility toggle, and one continue action.",
  "category": "application",
  "manifestVersion": 1,
  "block": true,
  "slots": [
    {
      "name": "headline",
      "part": "text",
      "required": false
    },
    {
      "name": "subhead",
      "part": "text",
      "required": false
    }
  ],
  "axes": {
    "layout": {
      "values": [
        "centered",
        "split"
      ],
      "default": "centered"
    }
  },
  "styleSurface": {},
  "tokensUsed": [
    "--border",
    "--border-width",
    "--card",
    "--destructive",
    "--muted-foreground",
    "--primary",
    "--radius"
  ],
  "dependencies": [
    "class-variance-authority"
  ],
  "registryDependencies": [
    "utils",
    "card",
    "label",
    "input",
    "password-toggle-field",
    "button"
  ],
  "files": [
    {
      "name": "auth-login",
      "source": "src/blocks/auth-login.tsx",
      "target": "components/blocks/auth-login.tsx",
      "type": "registry:block"
    }
  ],
  "composition": {
    "contentSlots": [
      {
        "name": "headline",
        "kind": "text",
        "required": false
      },
      {
        "name": "subhead",
        "kind": "text",
        "required": false
      }
    ],
    "childComponents": [
      {
        "name": "card",
        "min": 1,
        "max": 1
      },
      {
        "name": "label",
        "min": 2
      },
      {
        "name": "input",
        "min": 1,
        "max": 1
      },
      {
        "name": "password-toggle-field",
        "min": 1,
        "max": 1
      },
      {
        "name": "button",
        "min": 1,
        "max": 1
      }
    ],
    "headingRole": "h1"
  },
  "standards": {
    "purpose": "Get returning users back in with the least friction.",
    "useWhen": [
      "An app needs email sign-in."
    ],
    "doNotUseWhen": [
      "SSO is the only path â€” don't show a password field that can't work."
    ],
    "rules": [
      {
        "id": "auth-login-labels",
        "severity": "error",
        "check": "Every field carries a real label and an inline error state; the password field offers a visibility toggle."
      }
    ]
  }
}
