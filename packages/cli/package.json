{
  "name": "@arche/cli",
  "version": "0.1.0",
  "description": "Install and check Arche component libraries: wire a library, add components and blocks, publish-safe upgrades, and a standards linter.",
  "keywords": ["arche", "shadcn", "components", "blocks", "cli", "design-system", "react", "tailwind"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/terrykn/arche-ui.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/terrykn/arche-ui/tree/main/packages/cli#readme",
  "bugs": "https://github.com/terrykn/arche-ui/issues",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "arche": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project . && node ./scripts/copy-assets.mjs",
    "check-types": "tsc --project . --noEmit",
    "lint": "eslint .",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@arche/foundation": "workspace:*",
    "@arche/registry-core": "workspace:*"
  },
  "devDependencies": {
    "@arche/eslint-config": "workspace:*",
    "@arche/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "typescript": "7.0.2"
  }
}
