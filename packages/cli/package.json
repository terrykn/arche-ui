{
  "name": "@arche/cli",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "arche": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project . && node ./scripts/copy-assets.mjs",
    "check-types": "tsc --project . --noEmit",
    "lint": "eslint .",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@arche/foundation": "workspace:*",
    "@arche/registry-core": "workspace:*"
  },
  "devDependencies": {
    "@arche/eslint-config": "workspace:*",
    "@arche/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "typescript": "7.0.2"
  }
}
