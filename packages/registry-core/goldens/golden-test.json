        "$value": "0 1px 2px 0 oklch(0.2 0.01 50 / 0.05)"
      },
      "--shadow-xl": {
        "$type": "shadow",
        "$value": "0 20px 25px -5px oklch(0.2 0.01 50 / 0.1)"
      }
    }
  },
  "typeScale": "standard-1.25"
}
