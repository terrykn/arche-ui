{
  "name": "@arche/registry-core",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./compiler": {
      "types": "./src/compiler.ts",
      "default": "./dist/compiler.js"
    },
    "./component-tokens": {
      "types": "./src/component-tokens.ts",
      "default": "./dist/component-tokens.js"
    },
    "./selector": {
      "types": "./src/selector.ts",
      "default": "./dist/selector.js"
    },
    "./genres": {
      "types": "./src/genres.ts",
      "default": "./dist/genres.js"
    },
    "./picker": {
      "types": "./src/picker.ts",
      "default": "./dist/picker.js"
    }
  },
  "scripts": {
    "build": "tsc --project . && node scripts/copy-adherence-assets.mjs",
    "check-types": "tsc --project . --noEmit",
    "lint": "eslint .",
    "emit": "pnpm build && node dist/cli.js",
    "test:goldens": "pnpm build && node scripts/check-goldens.mjs",
    "test:goldens:write": "pnpm build && node scripts/check-goldens.mjs --write",
    "test:rules": "pnpm build && node --test scripts/test-design-rules.mjs",
    "test:fonts": "pnpm build && node --test scripts/test-fonts.mjs",
    "test:presentation": "pnpm build && node --test scripts/test-presentation.mjs",
    "test:blocks": "pnpm build && node --test scripts/test-blocks.mjs",
    "test:selector": "pnpm build && node --test scripts/test-selector.mjs",
    "test:words": "pnpm build && node --test scripts/test-words.mjs",
    "test:picker": "pnpm build && node --test scripts/test-picker.mjs",
    "test:picker-recompile": "pnpm build && node --test scripts/test-picker-recompile.mjs",
    "test:verification": "pnpm build && node --test scripts/test-verification.mjs",
    "test:dna-v2": "pnpm build && node --test scripts/test-dna-v2.mjs",
    "test:prompt-adherence": "pnpm build && node --test scripts/test-prompt-adherence.mjs",
    "test:variants": "pnpm build && node --test scripts/test-variants.mjs",
    "test:brand": "pnpm build && node --test scripts/test-brand.mjs",
    "test:brand-picker": "pnpm build && node --test scripts/test-brand-picker.mjs"
  },
  "dependencies": {
    "@arche/foundation": "workspace:*",
    "ajv": "^8.17.1",
    "zod": "^4.1.14"
  },
  "devDependencies": {
    "@arche/eslint-config": "workspace:*",
    "@arche/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "typescript": "7.0.2"
  }
}
